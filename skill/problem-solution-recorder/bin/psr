#!/usr/bin/env bash
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
# 跟随符号链接（install.sh --bin 会把 psr 链接到 ~/.local/bin）
while [[ -L "$SELF" ]]; do
  link="$(readlink "$SELF")"
  case "$link" in
    /*) SELF="$link" ;;
    *) SELF="$(dirname "$SELF")/$link" ;;
  esac
done
SELF="$( ( unset CDPATH; cd -P -- "$(dirname -- "$SELF")" >/dev/null 2>&1 && pwd -P ) )/$(basename "$SELF")"
SKILL_DIR="$( ( unset CDPATH; cd -P -- "$(dirname -- "$SELF")/.." >/dev/null 2>&1 && pwd -P ) )"
SCRIPTS="$SKILL_DIR/scripts"
LIB="$SCRIPTS/lib"

# shellcheck source=/dev/null
. "$LIB/enumerate.sh"

# 知识库内的副本（<kb>/bin/psr）默认管理它所在的知识库。
LOCAL_KB=""
if [[ -f "$SKILL_DIR/AI入口.md" && -f "$SKILL_DIR/INDEX.md" ]]; then
  LOCAL_KB="$SKILL_DIR"
fi

die() {
  printf 'psr: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
psr - problem-solution recorder CLI

Usage:
  psr configure --global <kb>          Save the knowledge base globally (XDG config)
  psr configure --project [kb] [--dir D]
                                       Write .problem-solution-root (default: cwd)
  psr configure --show                 Show the resolved knowledge base and its source
  psr init <kb> [--with-examples] [--force] [--dry-run]
                                       Create an empty knowledge base (examples optional)
  psr doctor                           Check the knowledge base and installation state
  psr new "Title" [--mode quick|full] [--date YYYY-MM-DD] [--tools a,b] [--tags a,b] [--slug s]
                                       Create a record (quick = 快记 template)
  psr finalize <id> --status solved|workaround|unresolved [--dry-run]
                                       Validate, set the machine status, sync both indexes
  psr search "query" [--regex] [--status S] [--tool T] [--tag G] [--since D] [--until D] [--limit N]
                                       Search records; literal by default
  psr review [--week YYYY-Www|--month YYYY-MM|--day YYYY-MM-DD] [--dry-run]
  psr review --open                    List unfinished follow-ups across all records
  psr index [--rebuild] [--web] [--allow-empty]
                                       Refresh the summary index (and INDEX.md / web data)
  psr --version

Legacy commands (scripts/qs in a knowledge base) keep working; both use the same
parser, lock, and index rules under scripts/lib/.
EOF
}

kb_root() {
  if [[ -n "$LOCAL_KB" ]]; then
    printf '%s\n' "$LOCAL_KB"
    return 0
  fi
  "$SCRIPTS/resolve-kb-root.sh"
}

require_root() {
  local root
  if ! root="$(kb_root)"; then
    die "未找到知识库。先运行: psr configure --global /path/to/kb（或 psr init /path/to/kb）"
  fi
  printf '%s\n' "$root"
}

# ---------------------------------------------------------------- configure
cmd_configure() {
  local scope=""
  local kb=""
  local dir="$PWD"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --global) scope="global"; shift ;;
      --project) scope="project"; shift ;;
      --show) scope="show"; shift ;;
      --dir) dir="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *)
        if [[ -z "$kb" ]]; then
          kb="$1"; shift
        else
          die "多余的参数: $1"
        fi
        ;;
    esac
  done

  case "$scope" in
    show)
      if [[ -n "$LOCAL_KB" ]]; then
        printf '知识库: %s\n' "$LOCAL_KB"
        printf '来源: 知识库内置副本（bin/psr）\n'
        printf '记录数: %s\n' "$(find "$LOCAL_KB/records" -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
        return 0
      fi
      local out root source
      if ! out="$("$SCRIPTS/resolve-kb-root.sh" --explain 2>/dev/null)"; then
        printf '知识库: 未配置\n'
        printf '提示: psr configure --global /path/to/kb 或 psr configure --project /path/to/kb\n'
        return 0
      fi
      root="${out%%	*}"
      source="${out#*	}"
      printf '知识库: %s\n' "$root"
      case "$source" in
        env) printf '来源: 环境变量 PROBLEM_SOLUTION_KB_ROOT\n' ;;
        marker:*) printf '来源: 项目标记 %s\n' "${source#marker:}" ;;
        xdg:*) printf '来源: 全局配置 %s\n' "${source#xdg:}" ;;
        arg) printf '来源: 命令行参数\n' ;;
        *) printf '来源: %s\n' "$source" ;;
      esac
      printf '记录数: %s\n' "$(find "$root/records" -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
      return 0
      ;;
    global)
      [[ -n "$kb" ]] || die "用法: psr configure --global /path/to/kb"
      local resolved
      resolved="$("$SCRIPTS/resolve-kb-root.sh" "$kb")" || die "不是有效的知识库（缺少 AI入口.md）: $kb"
      local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
      mkdir -p "$config_home/problem-solution-recorder"
      printf '%s\n' "$resolved" > "$config_home/problem-solution-recorder/root"
      printf '已配置全局知识库: %s\n' "$resolved"
      printf '配置文件: %s\n' "$config_home/problem-solution-recorder/root"
      return 0
      ;;
    project)
      [[ -n "$kb" ]] || die "用法: psr configure --project [--dir D] /path/to/kb"
      local resolved
      resolved="$("$SCRIPTS/resolve-kb-root.sh" "$kb")" || die "不是有效的知识库（缺少 AI入口.md）: $kb"
      [[ -d "$dir" ]] || die "目录不存在: $dir"
      printf '%s\n' "$resolved" > "$dir/.problem-solution-root"
      printf '已配置项目标记: %s\n' "$dir/.problem-solution-root"
      printf '知识库: %s\n' "$resolved"
      return 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

# ---------------------------------------------------------------- init
cmd_init() {
  local target=""
  local args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --with-examples|--force|--dry-run) args+=("$1"); shift ;;
      -h|--help) usage; exit 0 ;;
      *)
        if [[ -z "$target" ]]; then
          target="$1"; shift
        else
          die "多余的参数: $1"
        fi
        ;;
    esac
  done

  [[ -n "$target" ]] || die "用法: psr init /path/to/kb [--with-examples]"
  "$SCRIPTS/init-kb.sh" "$target" ${args[@]+"${args[@]}"}
  printf '下一步:\n'
  printf '  psr configure --global %s\n' "$target"
  printf '  psr new "第一个问题" --mode quick\n'
}

# ---------------------------------------------------------------- doctor
cmd_doctor() {
  local root
  root="$(require_root)"

  local status=0
  "$SCRIPTS/doctor-local.sh" "$root" || status=$?

  printf '\n安装与发现:\n'
  if [[ -n "$LOCAL_KB" ]]; then
    printf '[info] 本副本位于知识库内（%s），安装诊断请运行 skill 目录的 scripts/install.sh\n' "$LOCAL_KB"
    printf '[unknown] 无法验证各工具是否实际加载了 skill；需在对应工具内触发一次\n'
    return "$status"
  fi
  local dir target resolved
  for dir in "$HOME/.agents/skills" "$HOME/.codex/skills" "$HOME/.claude/skills" "$HOME/.cursor/skills-cursor" "$HOME/.openclaw/skills"; do
    target="$dir/problem-solution-recorder"
    if [[ -L "$target" ]]; then
      resolved="$( ( unset CDPATH; cd -P -- "$target" >/dev/null 2>&1 && pwd -P ) )" || resolved=""
      if [[ "$resolved" == "$SKILL_DIR" ]]; then
        printf '[installed] %s -> %s\n' "$target" "$SKILL_DIR"
      else
        printf '[different] %s -> %s（不是当前 skill）\n' "$target" "${resolved:-?}"
      fi
    elif [[ -d "$target" ]]; then
      printf '[installed] %s（复制安装）\n' "$target"
    else
      printf '[absent] %s\n' "$target"
    fi
  done

  if command -v psr >/dev/null 2>&1; then
    printf '[ok] psr 在 PATH 中: %s\n' "$(command -v psr)"
  else
    printf '[warn] psr 不在 PATH 中；可运行 scripts/install.sh --bin\n'
  fi
  printf '[unknown] 无法验证各工具是否实际加载了 skill；需在对应工具内触发一次\n'

  return "$status"
}

# ---------------------------------------------------------------- new
cmd_new() {
  local title=""
  local mode="full"
  local date_arg=""
  local tools=""
  local tags=""
  local slug=""
  local args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode) mode="${2:-}"; shift 2 ;;
      --date) date_arg="${2:-}"; shift 2 ;;
      --tools) tools="${2:-}"; shift 2 ;;
      --tags) tags="${2:-}"; shift 2 ;;
      --slug) slug="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *)
        if [[ -z "$title" ]]; then
          title="$1"; shift
        else
          die "多余的参数: $1"
        fi
        ;;
    esac
  done

  [[ -n "$title" ]] || die "用法: psr new \"标题\" [--mode quick|full]"
  case "$mode" in
    quick|full) ;;
    *) die "--mode 只支持 quick 或 full: $mode" ;;
  esac

  local root
  root="$(require_root)"

  local template=""
  if [[ "$mode" == "quick" ]]; then
    template="$root/_templates/快记模板.md"
    [[ -f "$template" ]] || die "缺少快记模板: $template"
  fi

  args=("$title" --root "$root")
  [[ -n "$date_arg" ]] && args+=(--date "$date_arg")
  [[ -n "$tools" ]] && args+=(--tools "$tools")
  [[ -n "$tags" ]] && args+=(--tags "$tags")
  [[ -n "$slug" ]] && args+=(--slug "$slug")
  [[ -n "$template" ]] && args+=(--template "$template")

  local path id out rc err saved_id
  err="$(mktemp "${TMPDIR:-/tmp}/psr-new.XXXXXX")"
  set +e
  out="$("$SCRIPTS/new-record.sh" "${args[@]}" 2>"$err")"
  rc=$?
  set -e
  path="$(printf '%s\n' "$out" | head -n 1)"

  if [[ "$rc" -ne 0 ]]; then
    if [[ -n "$path" && -f "$path" ]]; then
      saved_id="$(fm_value "$path" id)"
      if [[ -z "$saved_id" ]]; then
        saved_id="$(basename "$path" | sed -n -E 's/^([0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,})-.*/\1/p')"
      fi
      printf '[fail] 记录已保存，但摘要索引未刷新\n' >&2
      printf '记录: %s（ID %s）\n' "${path#"$root"/}" "$saved_id" >&2
      printf '恢复: %s/update-ai-summary-index.sh "%s"\n' "$SCRIPTS" "$root" >&2
      rm -f "$err"
      exit 3
    fi
    cat "$err" >&2
    rm -f "$err"
    die "创建记录失败"
  fi
  rm -f "$err"

  id="$(fm_value "$path" id)"
  if [[ -z "$id" ]]; then
    # 四位以上序号也要完整显示，不能用固定宽度截断。
    id="$(basename "$path" | sed -n -E 's/^([0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,})-.*/\1/p')"
  fi
  [[ -n "$id" ]] || die "无法从记录文件名解析 ID: $path"

  printf '知识库: %s\n' "$root"
  printf '已创建: %s\n' "${path#"$root"/}"
  printf 'ID: %s\n' "$id"
  printf '下一步: 补全内容后运行 psr finalize %s --status solved\n' "$id"
}

# ---------------------------------------------------------------- finalize
section_has_content() {
  local file="$1"
  local heading="$2"
  LC_ALL=C awk -v h="$heading" '
    function placeholder(line) {
      if (line == "") return 1
      if (line ~ /^\[[ xX]\]$/) return 1
      if (line ~ /^用 1 到 3 句话/) return 1
      if (line ~ /^写清楚最终改了什么/) return 1
      if (line ~ /^分层写清楚/) return 1
      if (line ~ /^用户看到的现象/) return 1
      if (line ~ /^下次看到类似现象/) return 1
      if (line ~ /^后续让 AI 总结/) return 1
      if (line ~ /^粘贴关键输出/) return 1
      if (line ~ /^关键成功输出/) return 1
      if (line ~ /^是否需要/) return 1
      if (line == "示例" || line ~ /"示例"/) return 1
      if (line ~ /^待(填写|补充)/) return 1
      if (line == "TBD" || line == "TODO" || line == "-") return 1
      # 只有标签没有内容，例如 "- 适用边界："。
      # LC_ALL=C 下按字节判断全角冒号，避免多字节字符类退化。
      if (line ~ /:$/) return 1
      if (length(line) >= 3 && substr(line, length(line) - 2) == "：") return 1
      return 0
    }
    BEGIN { in_fence = 0; fence = ""; in_comment = 0 }
    $0 == "## " h { s = 1; next }
    s {
      line = $0

      # 多行 HTML 注释：整段忽略（含跨行）。
      if (in_comment) {
        if (index(line, "-->") > 0) in_comment = 0
        next
      }
      if (match(line, /^[[:space:]]*<!--/)) {
        rest = substr(line, RSTART + RLENGTH)
        if (index(rest, "-->") == 0) in_comment = 1
        next
      }

      # 两种围栏（``` 与 ~~~）：围栏内的 ## 不是章节边界。
      if (match(line, /^[[:space:]]*(```|~~~)/)) {
        m = substr(line, RSTART + RLENGTH - 3, 3)
        if (!in_fence) {
          in_fence = 1
          fence = m
        } else if (m == fence) {
          in_fence = 0
          fence = ""
        }
        next
      }

      if (!in_fence && line ~ /^## /) exit

      if (in_fence) {
        sub(/^[[:space:]]+/, "", line)
        sub(/[[:space:]]+$/, "", line)
        if (line ~ /^#/) next
        if (line ~ /^[{}[\].,;]+$/) next
        if (placeholder(line)) next
        found = 1
        exit
      }

      gsub(/^[[:space:]*-]+/, "", line)
      gsub(/[[:space:]]+$/, "", line)
      if (placeholder(line)) next
      found = 1
      exit
    }
    END { exit(found ? 0 : 1) }
  ' "$file"
}

# 记录正文（去掉 front matter，首个标题归一化）与模板一致时，说明完全没有填写。
strip_body_for_compare() {
  LC_ALL=C awk '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm && $0 == "---" { fm = 0; next }
    fm { next }
    /^#[[:space:]]/ { if (!h) { h = 1; print "# TITLE"; next } }
    # 空行差异（front matter 后的空行数量）不影响“是否填写”的判断。
    $0 == "" { next }
    { print }
  ' "$1"
}

record_matches_template() {
  local file="$1"
  local template="$2"
  [[ -f "$template" ]] || return 1
  local a b
  a="$(strip_body_for_compare "$file" | cksum)"
  b="$(strip_body_for_compare "$template" | cksum)"
  [[ -n "$a" && "$a" == "$b" ]]
}

# 读取 front matter 里的单个字段（只认第一个 --- 块）。
fm_value() {
  local file="$1"
  local key="$2"
  LC_ALL=C awk -v k="$key" '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm && $0 == "---" { exit }
    fm && index($0, k ":") == 1 {
      sub("^" k ":[[:space:]]*", "")
      gsub(/^"|"$/, "")
      print
      exit
    }
  ' "$file"
}

# 读取 front matter 的列表字段（行内数组或块列表），输出 "a, b"。
fm_list_value() {
  local file="$1"
  local key="$2"
  LC_ALL=C awk -v k="$key" '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm && $0 == "---" { exit }
    fm && index($0, k ":") == 1 {
      v = substr($0, length(k) + 2)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
      if (v ~ /^\[.*\]$/) {
        v = substr(v, 2, length(v) - 2)
        n = split(v, p, ",")
        out = ""
        for (i = 1; i <= n; i++) {
          s = p[i]
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", s)
          gsub(/^"|"$/, "", s)
          if (s != "") out = out (out == "" ? "" : ", ") s
        }
        print out
        exit
      }
      if (v != "") { print v; exit }
      while ((getline line) > 0) {
        if (line ~ /^---/) break
        if (line ~ /^[[:space:]]*-[[:space:]]+/) {
          s = line
          sub(/^[[:space:]]*-[[:space:]]+/, "", s)
          gsub(/^"|"$/, "", s)
          out = out (out == "" ? "" : ", ") s
        } else if (line ~ /^[A-Za-z0-9_-]+:/) break
      }
      print out
      exit
    }
  ' "$file"
}

record_status() {
  local file="$1"
  LC_ALL=C awk '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm && $0 == "---" { exit }
    fm && /^status:/ { sub(/^status:[[:space:]]*/, ""); gsub(/^"|"$/, ""); print; exit }
  ' "$file"
}

set_record_status() {
  local file="$1"
  local status="$2"
  local tmp mode
  tmp="$(mktemp "${TMPDIR:-/tmp}/psr-status.XXXXXX")"

  if [[ "$(head -n 1 "$file")" != "---" ]]; then
    # 没有 front matter：补一个最小块，而不是改到正文。
    { printf -- '---\nstatus: %s\n---\n\n' "$status"; cat "$file"; } > "$tmp"
  else
    LC_ALL=C awk -v st="$status" '
      BEGIN { fm = 0; seen = 0 }
      NR == 1 && $0 == "---" { fm = 1; print; next }
      fm && $0 == "---" {
        if (!seen) print "status: " st
        fm = 0; print; next
      }
      fm && !seen && /^status:/ { print "status: " st; seen = 1; next }
      { print }
    ' "$file" > "$tmp"
  fi

  mode="$(stat -f %Lp "$file" 2>/dev/null || stat -c %a "$file" 2>/dev/null || true)"
  if [[ -n "$mode" ]]; then
    chmod "$mode" "$tmp" 2>/dev/null || true
  fi

  # 写回后再确认，避免把失败当成成功。
  if [[ "$(LC_ALL=C awk '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm && $0 == "---" { exit }
    fm && /^status:/ { sub(/^status:[[:space:]]*/, ""); gsub(/^"|"$/, ""); print; exit }
  ' "$tmp")" != "$status" ]]; then
    rm -f "$tmp"
    printf 'psr: 无法在 front matter 中写入状态: %s\n' "$file" >&2
    return 1
  fi

  mv "$tmp" "$file"
}

count_followups() {
  local file="$1"
  LC_ALL=C awk '
    $0 == "## 后续事项" { s = 1; next }
    s && /^## / { exit }
    s && /^- \[[ xX]\]/ && $0 !~ /^[-*][[:space:]]*\[[ xX]\][[:space:]]*是否需要/ { n++ }
    END { print n + 0 }
  ' "$file"
}

cmd_finalize() {
  local id=""
  local target_status=""
  local dry_run=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) target_status="${2:-}"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *)
        if [[ -z "$id" ]]; then
          id="$1"; shift
        else
          die "多余的参数: $1"
        fi
        ;;
    esac
  done

  [[ -n "$id" ]] || die "用法: psr finalize <id> --status solved|workaround|unresolved"
  case "$target_status" in
    solved|workaround|unresolved) ;;
    "") die "--status 必填：solved | workaround | unresolved" ;;
    *) die "--status 只支持 solved | workaround | unresolved: $target_status" ;;
  esac

  local root
  root="$(require_root)"

  if [[ ! "$id" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,}$ ]]; then
    printf 'psr: 记录 ID 格式应为 YYYY-MM-DD-NNN（序号至少三位）: %s\n' "$id" >&2
    exit 2
  fi

  # 归档必须在同一把写锁内完成定位、校验与写入：否则等待锁期间
  # 记录可能被改成空内容，先前的校验结果就失效了（dry-run 保持只读）。
  if [[ "$dry_run" -eq 0 ]]; then
    # shellcheck source=/dev/null
    . "$LIB/lock.sh"
    # shellcheck source=/dev/null
    . "$LIB/index.sh"
    # trap 在函数返回后执行，必须用全局变量而不是 local root。
    PSR_LOCK_ROOT="$root"
    trap 'psr_lock_release "$PSR_LOCK_ROOT"' EXIT
    trap 'psr_lock_release "$PSR_LOCK_ROOT"; exit 130' INT TERM HUP
    psr_lock_acquire "$root" || die "获取写锁失败"
  fi

  local matches=() list
  list="$(mktemp "${TMPDIR:-/tmp}/psr-finalize.XXXXXX")"
  if ! psr_list_records "$root/records" "$list"; then
    rm -f "$list"
    printf 'psr: 读取记录目录失败，未修改任何文件\n' >&2
    exit 2
  fi
  while IFS= read -r f; do
    [[ "${f##*/}" == "$id"-*.md ]] && matches+=("$f")
  done < "$list"
  rm -f "$list"

  if [[ ${#matches[@]} -eq 0 ]]; then
    die "找不到记录: $id"
  fi
  if [[ ${#matches[@]} -gt 1 ]]; then
    printf 'psr: ID %s 对应多条记录，拒绝猜测：\n' "$id" >&2
    local dup
    for dup in "${matches[@]}"; do
      printf '  - %s\n' "${dup#"$root"/}" >&2
    done
    exit 1
  fi
  local file="${matches[0]}"

  local rel="${file#"$root"/}"
  local title
  title="$(LC_ALL=C awk '/^#[[:space:]]+/ { sub(/^#[[:space:]]+/, ""); print; exit }' "$file")"
  [[ -n "$title" ]] || title="$id"

  # ---- 模板未填写直接拒绝 ----
  local tpl
  for tpl in "$root/_templates/快记模板.md" "$root/_templates/问题记录模板.md"; do
    if record_matches_template "$file" "$tpl"; then
      printf '[fail] 记录内容仍是模板原文，未做任何填写\n' >&2
      printf '记录已保存: %s（ID %s）\n' "$rel" "$id" >&2
      printf '编辑后重试: psr finalize %s --status %s\n' "$id" "$target_status" >&2
      exit 1
    fi
  done

  # ---- 按目标状态校验内容 ----
  local missing=()
  case "$target_status" in
    solved)
      section_has_content "$file" "根因分析" || missing+=("根因分析")
      section_has_content "$file" "最终解决方案" || missing+=("最终解决方案")
      section_has_content "$file" "验证方法" || missing+=("验证方法")
      ;;
    workaround)
      section_has_content "$file" "最终解决方案" || missing+=("最终解决方案")
      section_has_content "$file" "验证方法" || missing+=("验证方法")
      section_has_content "$file" "限制与风险" || missing+=("限制与风险")
      ;;
    unresolved)
      section_has_content "$file" "原始现象" || missing+=("原始现象")
      section_has_content "$file" "后续事项" || missing+=("后续事项")
      ;;
  esac

  if [[ ${#missing[@]} -gt 0 ]]; then
    printf '[fail] 无法归档为 %s：以下章节没有有效内容\n' "$target_status" >&2
    local m
    for m in "${missing[@]}"; do
      printf '  - %s\n' "$m" >&2
    done
    printf '记录已保存: %s（ID %s）\n' "$rel" "$id" >&2
    printf '补全后重试: psr finalize %s --status %s\n' "$id" "$target_status" >&2
    exit 1
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    printf '[dry-run] 将把 %s 的状态设为 %s 并同步索引\n' "$id" "$target_status"
    printf '[dry-run] 记录: %s\n' "$rel"
    return 0
  fi

  local index="$root/INDEX.md"
  local schema label old_cell new_row row_fields
  schema="$(psr_index_schema "$index")"
  label="$(psr_status_label "$target_status" "$schema")"

  set_record_status "$file" "$target_status" || die "状态写入失败，记录未修改"

  # 索引状态：工具占位值才覆盖；人工状态保留并检查冲突。
  local index_note="已同步"
  if [[ -f "$index" ]] && grep -Fq "$rel" "$index"; then
    row_fields="$(psr_index_rows "$index" | awk -F'\037' -v id="$id" -v rel="$rel" '
      ($1 == id) || ($1 == "" && $7 == rel) { print; exit }
    ')"
    if [[ -n "$row_fields" ]]; then
      local f_id f_date f_title f_tools f_status f_root f_rel f_tags
      IFS=$'\037' read -r f_id f_date f_title f_tools f_status f_root f_rel f_tags <<< "$row_fields"
      old_cell="$f_status"
      if psr_status_is_tool_owned "$old_cell"; then
        new_row="$(psr_index_row "$schema" "$f_id" "$f_date" "$f_title" "$f_tools" "${f_tags:--}" "$label" "$f_root" "$f_rel")"
        psr_index_replace_row "$index" "$f_id" "$f_rel" "$new_row"
      else
        local human_machine
        human_machine="$(psr_status_machine "$old_cell")"
        if [[ -n "$human_machine" && "$human_machine" != "$target_status" ]]; then
          index_note="保留人工状态「${old_cell}」；与机器状态 $target_status 不一致，请确认"
        fi
      fi
    fi
  else
    local rec_date rec_tools rec_tags
    rec_date="$(fm_value "$file" date)"
    [[ -n "$rec_date" ]] || rec_date="$(basename "$file" | cut -c1-10)"
    rec_tools="$(fm_list_value "$file" tools)"
    rec_tags="$(fm_list_value "$file" tags)"
    new_row="$(psr_index_row "$schema" "$id" "$rec_date" "$title" "${rec_tools:--}" "${rec_tags:--}" "$label" "待补充" "$rel")"
    psr_index_insert "$index" "$new_row" "$id"
    index_note="已补入索引"
  fi

  local summary_note="已更新"
  if ! "$SCRIPTS/update-ai-summary-index.sh" "$root" --no-lock >/dev/null 2>&1; then
    printf '[fail] 摘要索引更新失败；记录已保存并写入状态\n' >&2
    printf '记录: %s（ID %s）\n' "$rel" "$id" >&2
    printf '恢复: psr index\n' >&2
    exit 1
  fi

  local web_note="" web_failed=0
  if [[ -f "$root/web/generate-data.js" ]]; then
    set +e
    web_note="$(refresh_web "$root")"
    local web_rc=$?
    set -e
    if [[ "$web_rc" -ne 0 ]]; then
      web_failed=1
    fi
  fi

  local check_note="通过" check_rc=0 check_err
  check_err="$(mktemp "${TMPDIR:-/tmp}/psr-secret.XXXXXX")"
  set +e
  "$SCRIPTS/check-kb.sh" "$root" --quiet >/dev/null 2>"$check_err"
  check_rc=$?
  set -e
  case "$check_rc" in
    0) check_note="通过" ;;
    1) check_note="未通过：发现疑似敏感信息" ;;
    *) check_note="结果未知：扫描无法完成" ;;
  esac

  printf '知识库: %s\n' "$root"
  printf '已归档: %s\n' "$title"
  if [[ "$label" == "$target_status" ]]; then
    printf '状态: %s\n' "$target_status"
  else
    printf '状态: %s（%s）\n' "$label" "$target_status"
  fi
  printf '记录: %s（ID %s）\n' "$rel" "$id"
  printf '索引: %s\n' "$index_note"
  printf '摘要索引: %s\n' "$summary_note"
  if [[ -n "$web_note" ]]; then
    printf '%s\n' "$web_note"
  fi
  printf '敏感检查: %s\n' "$check_note"
  printf '后续事项: %s 项\n' "$(count_followups "$file")"

  if [[ "$check_rc" -ne 0 ]]; then
    sed -n '1,20p' "$check_err" >&2
    rm -f "$check_err"
    printf '记录已保存并归档，但敏感检查未通过。\n' >&2
    printf '处理后重跑: %s/check-kb.sh "%s"\n' "$SCRIPTS" "$root" >&2
    if [[ "$check_rc" -eq 1 ]]; then
      exit 1
    fi
    exit 2
  fi
  rm -f "$check_err"

  if [[ "$web_failed" -eq 1 ]]; then
    printf '记录已保存并归档，但 Web 数据待同步。\n' >&2
    printf '恢复: psr index --web\n' >&2
    exit 1
  fi

  return 0
}


# ---------------------------------------------------------------- maintenance
refresh_web() {
  local root="$1"
  local gen="$root/web/generate-data.js"

  [[ -f "$gen" ]] || return 0
  if ! command -v node >/dev/null 2>&1; then
    printf 'Web: 待同步（未找到 node）\n'
    return 1
  fi
  if node "$gen" >/dev/null 2>&1; then
    printf 'Web: 已同步\n'
    return 0
  fi
  printf 'Web: 待同步（%s 执行失败）\n' "$gen"
  return 1
}

cmd_index() {
  local rebuild=0
  local web=0
  local allow_empty=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --rebuild) rebuild=1; shift ;;
      --web) web=1; shift ;;
      --allow-empty) allow_empty=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "多余的参数: $1" ;;
    esac
  done

  local root
  root="$(require_root)"

  if [[ "$rebuild" -eq 1 ]]; then
    local args=("$root")
    [[ "$allow_empty" -eq 1 ]] && args+=(--allow-empty)
    "$SCRIPTS/rebuild-index.sh" "${args[@]}" || die "重建索引失败"
  fi
  "$SCRIPTS/update-ai-summary-index.sh" "$root" || die "更新摘要索引失败"
  if [[ "$web" -eq 1 ]]; then
    refresh_web "$root" || die "Web 同步失败"
  fi
}

# ---------------------------------------------------------------- search
# 统一记录流：rel, id, date, title, status, tools, tags, signature, root,
# fix, verify, reuse, follow_items（\036 分隔，保留 [ ]/[x]）, summary。
records_tsv() {
  local root="$1"
  local files=()
  local stream list

  list="$(mktemp "${TMPDIR:-/tmp}/psr-records-list.XXXXXX")"
  if ! psr_list_records "$root/records" "$list"; then
    rm -f "$list"
    return 2
  fi
  while IFS= read -r f; do
    files+=("$f")
  done < "$list"
  rm -f "$list"

  [[ ${#files[@]} -gt 0 ]] || return 0

  stream="$(mktemp "${TMPDIR:-/tmp}/psr-records.XXXXXX")"
  if ! LC_ALL=C awk -v root="$root" -v maxlines=20 -f "$LIB/record-fields.awk" "${files[@]}" > "$stream" 2>/dev/null; then
    rm -f "$stream"
    return 2
  fi

  LC_ALL=C awk -F'\t' '
    function emit() {
      printf "%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n", \
        rel, v["id"], v["date"], v["title"], v["status"], v["tools"], v["tags"], \
        v["signature"], v["root"], v["fix"], v["verify"], v["reuse"], v["follow_items"], v["summary"]
    }
    $1 == "@R" { if (rel != "") emit(); rel = $2; delete v; next }
    $1 == "@F" { v[$2] = $3; next }
    END { if (rel != "") emit() }
  ' "$stream"

  rm -f "$stream"
}

cmd_search() {
  local query=""
  local regex=0
  local limit=5
  local status_f=""
  local tool_f=""
  local tag_f=""
  local since=""
  local until=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --regex) regex=1; shift ;;
      --limit) limit="${2:-}"; shift 2 ;;
      --status) status_f="${2:-}"; shift 2 ;;
      --tool) tool_f="${2:-}"; shift 2 ;;
      --tag) tag_f="${2:-}"; shift 2 ;;
      --since) since="${2:-}"; shift 2 ;;
      --until) until="${2:-}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *)
        if [[ -z "$query" ]]; then
          query="$1"; shift
        else
          die "多余的参数: $1"
        fi
        ;;
    esac
  done

  [[ -n "$query" ]] || die "用法: psr search \"关键词\" [--limit N]"
  [[ "$limit" =~ ^[0-9]+$ ]] || die "--limit 必须是数字: $limit"

  local root
  root="$(require_root)"

  if [[ "$regex" -eq 1 ]]; then
    set +e
    printf '' | grep -qE -- "$query" 2>/dev/null
    local re_rc=$?
    set -e
    if [[ "$re_rc" -gt 1 ]]; then
      printf 'psr: 正则表达式无效: %s\n' "$query" >&2
      exit 2
    fi
  fi

  local tsv
  set +e
  tsv="$(records_tsv "$root")"
  local read_rc=$?
  set -e
  if [[ "$read_rc" -ne 0 ]]; then
    printf 'psr: 读取记录失败（退出码 %s），结果未知\n' "$read_rc" >&2
    exit 2
  fi
  if [[ -z "$tsv" ]]; then
    printf '没有结果：知识库中没有记录\n'
    return 1
  fi

  local found=0
  local rc=0
  set +e
  found="$(printf '%s\n' "$tsv" | PSR_SEARCH_QUERY="$query" LC_ALL=C awk -F'\037' \
    -v re="$regex" -v limit="$limit" \
    -v st="$status_f" -v tool="$tool_f" -v tag="$tag_f" \
    -v since="$since" -v until="$until" '
    function lc(s) { return tolower(s) }
    function hits(field,   i, h) {
      if (field == "") return 0
      h = 0
      for (i = 1; i <= nterms; i++) {
        if (re == 1) { if (lc(field) ~ qre) h++ }
        else if (index(lc(field), terms[i]) > 0) h++
      }
      return h
    }
    function weight(field, w) { return w * hits(field) / nterms }
    BEGIN {
      q = ENVIRON["PSR_SEARCH_QUERY"]
      if (re == 1) {
        nterms = 1
        terms[1] = lc(q)
        qre = lc(q)
      } else {
        nterms = split(lc(q), terms, /[ \t]+/)
      }
      n = 0
    }
    {
      rel = $1; id = $2; date = $3; title = $4; status = $5
      tools = $6; tags = $7; sig = $8; root = $9; fix = $10
      verify = $11; reuse = $12; follow = $13; summ = $14

      if (st != "" && status != st) next
      if (tool != "" && index(lc(tools), lc(tool)) == 0) next
      if (tag != "" && index(lc(tags), lc(tag)) == 0) next
      if (since != "" && date < since) next
      if (until != "" && date > until) next

      # 多词查询：所有词都必须出现在这条记录里（AND），再按字段加权。
      alltext = lc(title " " id " " tools " " tags " " sig " " root " " fix " " verify " " reuse " " follow " " summ)
      if (re == 1) {
        if (alltext !~ qre) next
      } else {
        ok = 1
        for (i = 1; i <= nterms; i++) {
          if (index(alltext, terms[i]) == 0) { ok = 0; break }
        }
        if (!ok) next
      }

      score = weight(title, 60) + weight(id, 50) + weight(sig, 40) + weight(summ, 40) + \
              weight(root, 20) + weight(fix, 20) + weight(verify, 20) + \
              weight(reuse, 20) + weight(tags, 15) + weight(tools, 15) + weight(follow, 10)
      if (re == 0 && lc(title) == lc(q)) score += 100

      why = ""
      if (hits(title) > 0) why = why (why == "" ? "" : "、") "标题"
      if (hits(id) > 0) why = why (why == "" ? "" : "、") "ID"
      if (hits(sig) > 0) why = why (why == "" ? "" : "、") "问题签名"
      if (hits(summ) > 0) why = why (why == "" ? "" : "、") "一句话结论"
      if (hits(root) > 0) why = why (why == "" ? "" : "、") "根因"
      if (hits(fix) > 0) why = why (why == "" ? "" : "、") "解决方案"
      if (hits(verify) > 0) why = why (why == "" ? "" : "、") "验证"
      if (hits(reuse) > 0) why = why (why == "" ? "" : "、") "复用经验"
      if (hits(tags) > 0) why = why (why == "" ? "" : "、") "标签"
      if (hits(tools) > 0) why = why (why == "" ? "" : "、") "工具"
      if (hits(follow) > 0) why = why (why == "" ? "" : "、") "后续事项"

      n++
      r_score[n] = score; r_rel[n] = rel; r_id[n] = id; r_date[n] = date
      r_title[n] = title; r_status[n] = status; r_tools[n] = tools
      r_verify[n] = verify; r_why[n] = why
    }
    END {
      for (i = 1; i <= n; i++) {
        best = i
        for (j = i + 1; j <= n; j++) {
          if (r_score[j] > r_score[best] || (r_score[j] == r_score[best] && r_date[j] > r_date[best])) best = j
        }
        if (best != i) {
          t = r_score[i]; r_score[i] = r_score[best]; r_score[best] = t
          t = r_rel[i]; r_rel[i] = r_rel[best]; r_rel[best] = t
          t = r_id[i]; r_id[i] = r_id[best]; r_id[best] = t
          t = r_date[i]; r_date[i] = r_date[best]; r_date[best] = t
          t = r_title[i]; r_title[i] = r_title[best]; r_title[best] = t
          t = r_status[i]; r_status[i] = r_status[best]; r_status[best] = t
          t = r_tools[i]; r_tools[i] = r_tools[best]; r_tools[best] = t
          t = r_verify[i]; r_verify[i] = r_verify[best]; r_verify[best] = t
          t = r_why[i]; r_why[i] = r_why[best]; r_why[best] = t
        }
      }

      shown = (n < limit) ? n : limit
      for (i = 1; i <= shown; i++) {
        draft = (r_status[i] == "draft" || r_status[i] == "inbox")
        printf "%d. [%s] %s\n", i, draft ? "draft" : r_status[i], r_title[i]
        printf "   id: %s  date: %s", r_id[i], r_date[i]
        if (r_tools[i] != "") printf "  tools: %s", r_tools[i]
        printf "\n"
        if (draft) printf "   状态: 草稿（未验证，不建议直接采用）\n"
        printf "   命中: %s\n", r_why[i]
        # 不在这里按字节截断：LC_ALL=C 下会切坏多字节字符。
        if (r_verify[i] != "") printf "   验证: %s\n", r_verify[i]
        printf "   来源: %s\n\n", r_rel[i]
      }
      if (n == 0) printf "没有结果\n"
      else if (n > shown) printf "（共 %d 条匹配，显示前 %d 条；用 --limit 查看更多）\n", n, shown
      exit (n == 0 ? 1 : 0)
    }
  ')"
  rc=$?
  set -e
  printf '%s\n' "$found"
  return "$rc"
}


# ---------------------------------------------------------------- review
valid_ymd() {
  local d="$1" out=""
  [[ "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 1
  out="$(date -d "$d" +%F 2>/dev/null || date -j -f "%Y-%m-%d" "$d" +%F 2>/dev/null || true)"
  [[ "$out" == "$d" ]]
}

valid_iso_week() {
  local key="$1" d="" out=""
  [[ "$key" =~ ^[0-9]{4}-W(0[1-9]|[1-4][0-9]|5[0-3])$ ]] || return 1
  d="$(date -d "${key}-1" +%F 2>/dev/null || date -j -f "%G-W%V-%u" "${key}-1" +%F 2>/dev/null || true)"
  # BSD date 可能不解析 ISO 周；能解析就做一次往返校验。
  [[ -n "$d" ]] || return 0
  out="$(date -d "$d" +%G-W%V 2>/dev/null || date -j -f "%Y-%m-%d" "$d" +%G-W%V 2>/dev/null || true)"
  [[ "$out" == "$key" ]]
}

iso_week() {
  local d="$1"
  if date -d "$d" +%G-W%V >/dev/null 2>&1; then
    date -d "$d" +%G-W%V
    return 0
  fi
  if date -j -f "%Y-%m-%d" "$d" +%G-W%V >/dev/null 2>&1; then
    date -j -f "%Y-%m-%d" "$d" +%G-W%V
    return 0
  fi
  return 1
}

review_open() {
  local root="$1"
  local tsv
  set +e
  tsv="$(records_tsv "$root")"
  local rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    printf 'psr: 读取记录失败（退出码 %s）\n' "$rc" >&2
    exit 2
  fi

  local out rc
  set +e
  out="$(printf '%s\n' "$tsv" | LC_ALL=C awk -F'\037' '
    {
      rel = $1; title = $4; follow = $13
      if (follow == "") next
      n = split(follow, items, "\036")
      for (i = 1; i <= n; i++) {
        it = items[i]
        if (it ~ /^\[ \]/) {
          count++
          printf "%d. %s\n   来源: %s（%s）\n", count, it, rel, title
        }
      }
    }
    END { if (count == 0) print "没有未完成的后续事项"; exit (count == 0 ? 1 : 0) }
  ')"
  rc=$?
  set -e
  printf '%s\n' "$out"
  # 没有待办是正常结果，用 0 退出，避免调用方把它当成错误。
  return 0
}

cmd_review() {
  local period="week"
  local key=""
  local dry_run=0
  local open_only=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --week) period="week"; key="${2:-}"; shift 2 ;;
      --month) period="month"; key="${2:-}"; shift 2 ;;
      --day) period="day"; key="${2:-}"; shift 2 ;;
      --open) open_only=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "多余的参数: $1" ;;
    esac
  done

  local root
  root="$(require_root)"

  if [[ "$open_only" -eq 1 ]]; then
    review_open "$root"
    return $?
  fi

  local label=""
  case "$period" in
    week)
      [[ -n "$key" ]] || key="$(date +%G-W%V)"
      [[ "$key" =~ ^[0-9]{4}-W[0-9]{2}$ ]] || die "周格式应为 YYYY-Www: $key"
      valid_iso_week "$key" || die "不存在的周: $key"
      label="每周"
      ;;
    month)
      [[ -n "$key" ]] || key="$(date +%Y-%m)"
      [[ "$key" =~ ^[0-9]{4}-(0[1-9]|1[0-2])$ ]] || die "月份格式应为 YYYY-MM: $key"
      label="每月"
      ;;
    day)
      [[ -n "$key" ]] || key="$(date +%F)"
      valid_ymd "$key" || die "不是有效日期: $key"
      label="每日"
      ;;
  esac

  local tsv
  set +e
  tsv="$(records_tsv "$root")"
  local rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    printf 'psr: 读取记录失败（退出码 %s），未写入复盘\n' "$rc" >&2
    exit 2
  fi

  # 用每条记录自己的日期判定所属周期（避免解析 ISO 周首日）。
  local tmpd keep
  tmpd="$(mktemp -d "${TMPDIR:-/tmp}/psr-review.XXXXXX")"
  PSR_REVIEW_TMPDIR="$tmpd"
  trap 'rm -rf "${PSR_REVIEW_TMPDIR:-}"' EXIT
  keep="$tmpd/keep"
  : > "$keep"
  printf '%s\n' "$tsv" | while IFS=$'\037' read -r rel id rdate rest; do
    [[ -n "$rel" ]] || continue
    case "$period" in
      week)
        w="$(iso_week "$rdate")" || continue
        [[ "$w" == "$key" ]] || continue
        ;;
      month) [[ "${rdate:0:7}" == "$key" ]] || continue ;;
      day) [[ "$rdate" == "$key" ]] || continue ;;
    esac
    printf '%s\n' "$rel" >> "$keep"
  done

  local block
  block="$(LC_ALL=C awk -F'\037' \
    -v key="$key" -v label="$label" -v now="$(date '+%F %T')" \
    'NR == FNR { keep[$0] = 1; next } ($1 in keep) { print }' "$keep" <(printf '%s\n' "$tsv") 2>/dev/null | LC_ALL=C awk -F'\037' \
    -v key="$key" -v label="$label" -v now="$(date '+%F %T')" '
    function addcount(map, srcmap, name, rel) {
      map[name]++
      if (index(srcmap[name], rel) == 0) srcmap[name] = srcmap[name] " " rel
    }
    {
      rel = $1; id = $2; date = $3; title = $4; status = $5
      tools = $6; tags = $7; sig = $8; root = $9; fix = $10
      verify = $11; reuse = $12; follow = $13


      nrec++
      st[status]++
      recs[nrec] = sprintf("- [%s] %s（%s）— %s", status, title, date, rel)

      nt = split(tags, tg, ", ")
      for (i = 1; i <= nt; i++) if (tg[i] != "") addcount(tagc, tagsrc, tg[i], rel)
      nl = split(tools, tl, ", ")
      for (i = 1; i <= nl; i++) if (tl[i] != "") addcount(toolc, toolsrc, tl[i], rel)

      if (reuse != "") {
        ncand++
        cand[ncand] = sprintf("- %s — %s\n  - 复用经验：%s", title, rel, reuse)
      }

      nf = split(follow, items, "\036")
      for (i = 1; i <= nf; i++) {
        it = items[i]
        if (it ~ /^\[[ xX]\] 是否需要/) next
        if (it ~ /^\[ \]/) {
          nopen++
          openitem[nopen] = sprintf("- %s — %s", it, rel)
        } else if (it ~ /^\[[xX]\]/) {
          ndone++
          doneitem[ndone] = sprintf("- %s — %s", it, rel)
        }
      }
    }
    END {
      printf "# %s复盘：%s\n\n", label, key
      printf "生成时间：%s\n\n", now
      printf "## 统计\n\n"
      printf "- 记录数：%d\n", nrec
      printf "- 状态分布："
      first = 1
      for (s in st) {
        if (!first) printf " / "
        printf "%s %d", s, st[s]
        first = 0
      }
      if (first) printf "无"
      printf "\n"
      printf "- 未完成事项：%d 项；已完成事项：%d 项\n\n", nopen, ndone

      printf "## 本期记录\n\n"
      if (nrec == 0) printf "- 本期没有记录。\n"
      else for (i = 1; i <= nrec; i++) printf "%s\n", recs[i]
      printf "\n"

      printf "## 重复问题\n\n"
      any = 0
      for (t in tagc) {
        if (tagc[t] >= 2) {
          any = 1
          printf "- 标签 %s 出现 %d 次：%s\n", t, tagc[t], tagsrc[t]
        }
      }
      for (t in toolc) {
        if (toolc[t] >= 2) {
          any = 1
          printf "- 工具 %s 出现 %d 次：%s\n", t, toolc[t], toolsrc[t]
        }
      }
      if (!any) printf "- 本期没有重复出现的标签或工具。\n"
      printf "\n"

      printf "## 未完成后续事项\n\n"
      if (nopen == 0) printf "- 无。\n"
      else for (i = 1; i <= nopen; i++) printf "%s\n", openitem[i]
      printf "\n"

      printf "## 已完成事项（不计入待办）\n\n"
      if (ndone == 0) printf "- 无。\n"
      else for (i = 1; i <= ndone; i++) printf "%s\n", doneitem[i]
      printf "\n"

      printf "## 方法候选\n\n"
      if (ncand == 0) printf "- 本期没有可沉淀的方法候选。\n"
      else for (i = 1; i <= ncand; i++) printf "%s\n", cand[i]
      printf "\n"
    }
  ')"

  local begin='<!-- PSR:BEGIN REVIEW -->'
  local endm='<!-- PSR:END REVIEW -->'
  local generated="$block"
  local file="$root/reviews/$key.md"

  if [[ "$dry_run" -eq 1 ]]; then
    printf '%s\n\n%s\n' "$begin" "$generated"
    printf '%s\n' "$endm"
    return 0
  fi

  # 复盘写入同样要纳入共享写锁，避免与 finalize / 手工编辑交叉。
  # shellcheck source=/dev/null
  . "$LIB/lock.sh"
  PSR_LOCK_ROOT="$root"
  trap 'psr_lock_release "$PSR_LOCK_ROOT"; rm -rf "${PSR_REVIEW_TMPDIR:-}"' EXIT
  trap 'psr_lock_release "$PSR_LOCK_ROOT"; rm -rf "${PSR_REVIEW_TMPDIR:-}"; exit 130' INT TERM HUP
  psr_lock_acquire "$root" || die "获取写锁失败"

  mkdir -p "$root/reviews"

  # 计数必须与替换一致：只有“独占整行”的 marker 才算有效；
  # 行内出现 marker 文本（例如说明文字里引用）走拒绝分支。
  local sub_begin=0 sub_end=0 begin_count=0 end_count=0 begin_line=0 end_line=0
  if [[ -f "$file" ]]; then
    sub_begin="$(grep -c -F "$begin" "$file" || true)"
    sub_end="$(grep -c -F "$endm" "$file" || true)"
    begin_count="$(grep -c -x -F "$begin" "$file" || true)"
    end_count="$(grep -c -x -F "$endm" "$file" || true)"
    begin_line="$(grep -n -x -F "$begin" "$file" | head -n 1 | cut -d: -f1 || true)"
    end_line="$(grep -n -x -F "$endm" "$file" | head -n 1 | cut -d: -f1 || true)"
  fi

  local tmp backup=""
  tmp="$(mktemp "${TMPDIR:-/tmp}/psr-review.XXXXXX")"

  if [[ ! -f "$file" || ! -s "$file" ]]; then
    # 新文件（或空文件）：直接写生成区。
    {
      printf '%s\n\n%s\n' "$begin" "$generated"
      printf '%s\n\n' "$endm"
      printf '## 手工笔记\n\n'
      printf '本区在重新生成复盘时保留，可自由编辑。\n'
    } > "$tmp"
  elif [[ "$begin_count" -eq 1 && "$end_count" -eq 1 && -n "$begin_line" && -n "$end_line" && "$begin_line" -lt "$end_line" ]]; then
    local current newblock
    current="$(awk -v b="$begin" -v e="$endm" '$0 == b { f = 1 } f { print } $0 == e { f = 0 }' "$file" | LC_ALL=C awk '/^生成时间：/ { print "生成时间：X"; next } { print }')"
    newblock="$( { printf '%s\n\n%s\n' "$begin" "$generated"; printf '%s\n' "$endm"; } | LC_ALL=C awk '/^生成时间：/ { print "生成时间：X"; next } { print }')"
    if [[ "$current" == "$newblock" ]]; then
      printf '复盘无变化: %s\n' "$file"
      rm -f "$tmp"
      return 0
    fi
    {
      awk -v b="$begin" -v e="$endm" '$0 == b { exit } { print }' "$file"
      printf '%s\n\n%s\n' "$begin" "$generated"
      printf '%s\n' "$endm"
      awk -v b="$begin" -v e="$endm" 'f { print } $0 == e { f = 1 }' "$file"
    } > "$tmp"
  elif [[ "$sub_begin" -eq 0 && "$sub_end" -eq 0 ]]; then
    # 纯手写的历史复盘：先备份，再把旧内容整段保留，绝不直接覆盖。
    backup="${file}.pre-marker.$(date +%Y%m%d%H%M%S).bak"
    cp -p "$file" "$backup"
    {
      printf '%s\n\n%s\n' "$begin" "$generated"
      printf '%s\n\n' "$endm"
      printf '## 历史内容（迁移自旧文件）\n\n'
      printf '以下内容来自没有生成标记的旧文件，已原样保留。\n\n'
      cat "$backup"
    } > "$tmp"
  else
    # 其余情况一律拒绝：同一行、行内引用、重复、顺序反转等。
    printf '[fail] %s 的生成标记异常，未写入。\n' "$file" >&2
    printf '  独占整行的 BEGIN：%s 个（行号 %s）\n' "$begin_count" "${begin_line:-无}" >&2
    printf '  独占整行的 END：%s 个（行号 %s）\n' "$end_count" "${end_line:-无}" >&2
    printf '要求各一个、独占整行，且 BEGIN 严格早于 END；原文件未改动。\n' >&2
    printf '如需迁移旧文件，请先删掉所有 marker 行再重试（会备份原文件）。\n' >&2
    rm -f "$tmp"
    exit 1
  fi

  mv "$tmp" "$file"
  printf '已生成: %s\n' "$file"
  if [[ -n "$backup" ]]; then
    printf '旧文件已备份: %s\n' "$backup"
  fi
}

# ---------------------------------------------------------------- main
version() {
  local v=""
  if [[ -f "$SKILL_DIR/SKILL.md" ]]; then
    v="$(awk '/^version:/ { sub(/^version:[[:space:]]*/, ""); print; exit }' "$SKILL_DIR/SKILL.md")"
  fi
  if [[ -n "$v" ]]; then printf 'psr %s\n' "$v"; else printf 'psr\n'; fi
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
  configure) cmd_configure "$@" ;;
  init) cmd_init "$@" ;;
  doctor) cmd_doctor "$@" ;;
  new) cmd_new "$@" ;;
  finalize) cmd_finalize "$@" ;;
  search) cmd_search "$@" ;;
  review) cmd_review "$@" ;;
  index) cmd_index "$@" ;;
  --version|version|-v) version ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
